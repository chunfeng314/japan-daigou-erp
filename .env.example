# 复制为 .env 并按实际修改（.env 已被 .gitignore 忽略）
ERP_SECRET_KEY=换成一段足够长的随机字符串
ERP_DB_PATH=data/erp.sqlite3
ERP_SESSION_MAX_AGE=43200

# 部署到 HTTPS 之后改成 1，让会话 cookie 带 Secure
ERP_COOKIE_SECURE=0

# 展示时区：库里一律存 UTC，界面与导出按这个时区显示（团队在国内，默认东八区）
ERP_DISPLAY_TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# AI 助手（二期）。走 OpenAI 兼容协议，DeepSeek / 通义 / Kimi / 中转站通用。
# 三个都留空 → 自动降级为「规则模式」，只认固定问法，不调用任何模型。
#
# DeepSeek 实际开放的模型名（用 `GET /v1/models` 查，会变）：
#   deepseek-flash    快、便宜  ← 推荐日常用
#   deepseek-v4-pro   更强、更慢、更贵
# ⚠️ 别写 `deepseek-chat` / `deepseek-reasoner` —— 它们只是别名，
#    都会被路由到 deepseek-flash，隐式映射不方便排查。
# ⚠️ DeepSeek 目前**没有视觉模型**（点名 deepseek-vl 会被 400 拒绝），
#    「截图预填录单」这类需求要另配支持视觉的厂商。
# ---------------------------------------------------------------------------
ERP_LLM_BASE_URL=
ERP_LLM_API_KEY=
ERP_LLM_MODEL=
ERP_LLM_TIMEOUT=45
# 一次提问最多几轮工具调用（防止模型陷进循环把额度烧光）
ERP_LLM_MAX_ROUNDS=4

# ---------------------------------------------------------------------------
# 订单截图存储
#   local = 存本机 data/uploads/（默认；开发与单机部署零外部依赖）
#   cos   = 腾讯云 COS，生产用；浏览器用预签名 URL **直传**，不经服务器中转
# ---------------------------------------------------------------------------
ERP_STORAGE=local
ERP_UPLOAD_DIR=data/uploads
ERP_MAX_UPLOAD_MB=10

# 只有 ERP_STORAGE=cos 时才需要下面这些
# 依赖：.venv/bin/pip install cos-python-sdk-v5
# 另外要在 COS 控制台给存储桶配置 CORS：
#   允许来源 = 本站域名，允许方法 = PUT/GET/HEAD，允许头部 = *
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-tokyo
COS_BUCKET=
COS_PREFIX=order-images
ERP_COS_SIGN_EXPIRE=900

# scripts/init_db.py 首次创建管理员时使用
ADMIN_USERNAME=admin
ADMIN_PASSWORD=改成强密码
ADMIN_DISPLAY_NAME=系统管理员

# 卡单（超时）阈值覆盖，逗号分隔；不填则用 app/sla.py 里的默认值
# ERP_SLA_DAYS=待采购=2,采购中=5,待上海收货=10
