# 生产环境配置模板 —— 部署时复制成 /srv/ri-ben-erp/.env 并逐项填好
#
# ⚠️ 这个文件本身也会被 .gitignore 之外的地方看到 —— 真正的 .env 永远不要进仓库。
#    生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------------------------------------------------------------------------
# 必填
# ---------------------------------------------------------------------------
# 【必须换掉】会话签名密钥。换了之后所有已登录会话失效（要重新登录），属正常。
ERP_SECRET_KEY=在这里填一段随机字符串

ERP_DB_PATH=data/erp.sqlite3
ERP_SESSION_MAX_AGE=43200

# 【HTTPS 上线后必须改成 1】否则会话 cookie 不带 Secure，明文信道可能被截获
# 对应的自检项：python -m scripts.preflight 会 warn
ERP_COOKIE_SECURE=1

# 界面与导出按这个时区显示。库里一律存 UTC，这里只影响展示。
# 业务在国内、服务器在东京 —— 建议保持东八区，避免大家看时间时换算。
ERP_DISPLAY_TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# 订单截图存储
#   local = 本机磁盘（单机可用，但多机不互通、且要连图片一起备份）
#   cos   = 腾讯云 COS，浏览器直传 —— **生产推荐**
# ---------------------------------------------------------------------------
ERP_STORAGE=cos
ERP_MAX_UPLOAD_MB=10
ERP_UPLOAD_DIR=data/uploads

# 选 cos 时必填；另外要在 COS 控制台给存储桶配 CORS：
#   允许来源 = https://erp.example.com
#   允许方法 = PUT, GET, HEAD
#   允许头部 = *
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-tokyo
COS_BUCKET=
COS_PREFIX=order-images
ERP_COS_SIGN_EXPIRE=900

# ---------------------------------------------------------------------------
# AI 助手
#   三个都留空 → 规则模式（查单/待办/卡单可用，截图识别与自由问答不可用）
# ---------------------------------------------------------------------------
ERP_LLM_BASE_URL=https://api.deepseek.com/v1
ERP_LLM_API_KEY=
# deepseek-flash：快、便宜、支持读图（截图预填要用它）
ERP_LLM_MODEL=deepseek-flash
ERP_LLM_TIMEOUT=45
ERP_LLM_MAX_ROUNDS=4

# ---------------------------------------------------------------------------
# 卡单阈值（天）。不填则用 app/sla.py 里的默认值。
# ⚠️ 默认值是开发时拍的，**上线前务必让老板按实际节奏校一遍**。
# ---------------------------------------------------------------------------
# ERP_SLA_DAYS=待采购=1,采购中=3,待上海收货=7,已收货待安排带货=7,已安排带货=14,已发货=14,待结算=7

# ---------------------------------------------------------------------------
# 首次建管理员（跑 init_db 时用；建完可以删掉这两行）
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=系统管理员
# ADMIN_PASSWORD=留空则随机生成并打印
